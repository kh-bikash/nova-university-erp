# Database configuration (e.g., Neon Postgres, local PostgreSQL)
DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# JWT Secret for authentication (generate a strong UUID/random string)
JWT_SECRET=your_jwt_secret_here

# Redis URL for caching/queue (e.g., Upstash)
REDIS_URL=redis://default:your_redis_password@your_redis_host:6379

# Admin Secret for creating admin accounts
ADMIN_SECRET=your_admin_secret_here

# Node environment
NODE_ENV=development
